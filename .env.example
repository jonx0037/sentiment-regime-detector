# =============================================================================
# Sentiment Regime Detector - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sentiment_db
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API Keys - Data Collection
# -----------------------------------------------------------------------------
# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=sentiment-regime-detector:v0.1.0 (by /u/your_username)

# Twitter/X API (https://developer.twitter.com/) - Optional, paid tier
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# NewsAPI (https://newsapi.org/) - Free tier: 100 requests/day
NEWS_API_KEY=your_newsapi_key

# Alpha Vantage (https://www.alphavantage.co/) - Optional, for market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Model to use for sentiment analysis
# Options: distilbert-base-uncased-finetuned-sst-2-english (dev)
#          ProsusAI/finbert (production)
#          ./models/finbert-finetuned (after HPC training)
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# Device for inference: cpu, cuda, mps (Apple Silicon)
MODEL_DEVICE=cpu

# Batch size for inference
MODEL_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Data Collection Settings
# -----------------------------------------------------------------------------
# Subreddits to monitor (comma-separated)
REDDIT_SUBREDDITS=wallstreetbets,investing,stocks,cryptocurrency,forex

# News sources for filtering
NEWS_SOURCES=bloomberg,reuters,financial-times,the-wall-street-journal

# Collection interval in minutes
COLLECTION_INTERVAL_MINUTES=60

# -----------------------------------------------------------------------------
# Optional: Monitoring & Observability
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
SENTRY_DSN=

# Weights & Biases for ML experiment tracking (HPC phase)
WANDB_API_KEY=
WANDB_PROJECT=sentiment-regime-detector
